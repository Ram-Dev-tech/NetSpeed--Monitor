<Window x:Class="NetSpeedOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSpeed Monitor" 
        Width="110" 
        Height="26" 
        WindowStyle="None" 
        ResizeMode="NoResize" 
        ShowInTaskbar="False"
        Topmost="True" 
        Background="Transparent">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Border Name="MainBorder" 
            Background="#CC2C529C" 
            BorderBrush="#25FFFFFF" 
            BorderThickness="1" 
            CornerRadius="13"
            MouseLeftButtonDown="Window_MouseLeftButtonDown"
            ToolTip="NetSpeed Monitor (Click Tray Icon for menu)">
        <Grid Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Download Speed -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="↓" 
                           Foreground="#E5FFFFFF" 
                           FontSize="10" 
                           FontWeight="Bold"
                           VerticalAlignment="Center" 
                           Margin="0,0,2,0"/>
                <TextBlock Name="TxtDownload" 
                           Text="0K" 
                           Foreground="#FFFFFF" 
                           FontFamily="Segoe UI Variable Text, Segoe UI" 
                           FontSize="10" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Space Separator -->
            <TextBlock Grid.Column="1" Text=" " Margin="3,0"/>

            <!-- Upload Speed -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="↑" 
                           Foreground="#E5FFFFFF" 
                           FontSize="10" 
                           FontWeight="Bold"
                           VerticalAlignment="Center" 
                           Margin="0,0,2,0"/>
                <TextBlock Name="TxtUpload" 
                           Text="0K" 
                           Foreground="#FFFFFF" 
                           FontFamily="Segoe UI Variable Text, Segoe UI" 
                           FontSize="10" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
